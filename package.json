{
	"name": "sandhost",
	"version": "0.0.1",
	"description": "sandbox hosting on Kubernetes",
	"author": "wtrn.dev",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:api": "node scripts/dev.mjs --filter=@wtrn/api",
		"dev:web": "node scripts/dev.mjs --filter=@wtrn/web",
		"dev:kill": "fuser -k 3000/tcp 4000/tcp || true",
		"check": "oxlint --fix && oxfmt",
		"k8s:up": "bash scripts/k8s-up.sh",
		"k8s:down": "bash scripts/k8s-down.sh",
		"db:push": "pnpm --filter @wtrn/db db:push",
		"db:seed": "pnpm --filter @wtrn/db db:seed",
		"db:studio": "pnpm --filter @wtrn/db db:studio",
		"pg:up": "docker compose up -d postgres",
		"pg:down": "docker compose down"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tailwindcss": "catalog:",
		"turbo": "catalog:"
	},
	"packageManager": "pnpm@11.5.1"
}
