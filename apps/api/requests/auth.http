@host = http://localhost:4000/api

###
# @name createUser

POST {{host}}/create-test-user

###
# @name login
POST {{host}}/auth/sign-in/email
Content-Type: application/json

{
	"email": "{{createUser.response.body.user.user.email}}",
	"password": "{{createUser.response.body.password}}"
}

###
# @name sessionTest

GET {{host}}/session-test
Cookie: {{login.response.headers.set-cookie}}
