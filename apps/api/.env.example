BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:4000
PORT=4000
TRUSTED_ORIGINS=http://localhost:3000

# Kubernetes sandbox backend
KUBE_CONTEXT=kind-sandhost
SANDBOX_NAMESPACE=sandhost
SANDBOX_DEFAULT_IMAGE=sandhost-agent:dev
SANDBOX_CPU_REQUEST=50m
SANDBOX_CPU_LIMIT=250m
SANDBOX_MEMORY_REQUEST=64Mi
SANDBOX_MEMORY_LIMIT=256Mi
SANDBOX_RECONCILE_INTERVAL_MS=4000
